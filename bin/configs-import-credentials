#!/usr/bin/env python3
"""Install a credential bundle received from configs-export-mac-credentials."""
import argparse
import datetime
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import sys
import tarfile
import tempfile

ENV_NAMES = {
    'OP_SERVICE_ACCOUNT_TOKEN', 'DIGITALOCEAN_ACCESS_TOKEN', 'DO_API_TOKEN',
    'VERCEL_TOKEN', 'RAILWAY_API_TOKEN', 'RAILWAY_TOKEN', 'PULUMI_ACCESS_TOKEN',
    'WAKATIME_API_KEY', 'OPENAI_API_KEY', 'ANTHROPIC_API_KEY', 'SOPS_AGE_KEY',
}
DESTINATIONS = {
    'atuin/key': '.local/share/atuin/key',
    'atuin/session': '.local/share/atuin/session',
    'doctl/config.yaml': '.config/doctl/config.yaml',
    'kube/config': '.kube/config',
    'vercel/auth.json': '.local/share/com.vercel.cli/auth.json',
    'vercel/config.json': '.local/share/com.vercel.cli/config.json',
    'railway/config.json': '.railway/config.json',
    'pulumi/credentials.json': '.pulumi/credentials.json',
    'graphite/user_config': '.config/graphite/user_config',
    'graphite/auth': '.config/graphite/auth',
    'graphite/auth.json': '.config/graphite/auth.json',
    'graphite/auth_token': '.config/graphite/auth_token',
    'graphite/legacy_user_config': '.graphite_user_config',
    'wakatime/config': '.wakatime.cfg',
    'rclone/rclone.conf': '.config/rclone/rclone.conf',
    'sops/age-keys.txt': '.config/sops/age/keys.txt',
    'cloudflared/cert.pem': '.cloudflared/cert.pem',
}
PRIVATE_FILES = {'private/zshrc', 'private/gitconfig', 'private/tmux.conf', 'private/mise.toml', 'private/cloudflared.yml'}
MAX_FILE = 8 * 1024 * 1024
MAX_BUNDLE = 64 * 1024 * 1024

class ImportErrorMessage(Exception):
    pass

def allowed(name):
    return (name in DESTINATIONS or name in PRIVATE_FILES or name in ('env.json', 'manifest.json')
            or re.fullmatch(r'cloudflared/[0-9a-fA-F-]{36}\.json', name)
            or re.fullmatch(r'project-env/[0-9]{3}-[A-Za-z0-9_.-]+', name))

def read_bundle(raw):
    if len(raw) > MAX_BUNDLE:
        raise ImportErrorMessage('Credential bundle exceeds the size limit.')
    files = {}
    with tarfile.open(fileobj=io.BytesIO(raw), mode='r:') as archive:
        for member in archive.getmembers():
            if (not member.isfile() or not allowed(member.name) or member.name in files
                    or '..' in PurePosixPath(member.name).parts or member.size > MAX_FILE
                    or member.size < 0):
                raise ImportErrorMessage('Bundle contains an unsupported, duplicate, linked, or oversized file.')
            files[member.name] = archive.extractfile(member).read()
    if 'manifest.json' not in files:
        raise ImportErrorMessage('Credential bundle has no manifest.')
    manifest = json.loads(files.pop('manifest.json'))
    if (not isinstance(manifest, dict) or manifest.get('format') != 1
            or not isinstance(manifest.get('files'), list)
            or any(not isinstance(name, str) for name in manifest['files'])
            or sorted(manifest['files']) != sorted(files)):
        raise ImportErrorMessage('Credential bundle manifest does not match its files.')
    for name, content in files.items():
        if name.endswith('.json') or name == 'env.json':
            json.loads(content)
    return files, manifest

def safe_path(home, relative):
    path = home
    parts = PurePosixPath(relative).parts
    for index, part in enumerate(parts):
        if part in ('', '.', '..') or part.startswith('/'):
            raise ImportErrorMessage('Unsupported destination path.')
        path = path / part
        if path.is_symlink():
            raise ImportErrorMessage('A credential destination is a symlink; resolve it before importing.')
        if index < len(parts) - 1 and path.exists() and not path.is_dir():
            raise ImportErrorMessage('A credential parent path is not a directory.')
    if path.exists() and not path.is_file():
        raise ImportErrorMessage('A credential destination is not a regular file.')
    return path

def env_values(raw):
    values = json.loads(raw)
    if not isinstance(values, dict) or not set(values) <= ENV_NAMES:
        raise ImportErrorMessage('Bundle contains an unsupported environment variable.')
    if any(not isinstance(value, str) or '\0' in value for value in values.values()):
        raise ImportErrorMessage('Bundle contains an invalid environment variable value.')
    if 'OP_SERVICE_ACCOUNT_TOKEN' in values and not values['OP_SERVICE_ACCOUNT_TOKEN'].startswith('ops_'):
        raise ImportErrorMessage('Expected a 1Password service account token.')
    return values

def write_private(path, content):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.configs-import-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(content)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def install_bundle(home, files, manifest):
    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    root_relative = f'.local/state/configs/mac-import/{timestamp}'
    planned = {}
    staged = []
    for name, content in files.items():
        if name == 'env.json':
            continue
        relative = DESTINATIONS.get(name)
        if relative is None and name.startswith('cloudflared/'):
            relative = '.cloudflared/' + name.split('/')[1]
        if relative is None:
            relative = root_relative + '/review/' + name
            staged.append(name)
        planned[relative] = content
    if 'env.json' in files:
        previous = safe_path(home, '.config/configs/credentials.json')
        values = env_values(previous.read_bytes()) if previous.is_file() else {}
        values.update(env_values(files['env.json']))
        planned['.config/configs/credentials.json'] = json.dumps(values).encode()
        planned['.config/configs/credentials.env'] = ''.join(
            f'export {key}={shlex.quote(value)}\n' for key, value in sorted(values.items())).encode()
    for relative in planned:
        safe_path(home, relative)
        safe_path(home, root_relative + '/backup/' + relative)
    status = {'format': 1, 'imported_at': timestamp, 'installed': sorted(planned),
              'staged_for_review': staged, 'backup_directory': str(home / root_relative / 'backup')}
    status_path = safe_path(home, '.local/state/configs/mac-import/latest-import.json')
    for relative, content in planned.items():
        path = safe_path(home, relative)
        if path.is_file():
            backup = safe_path(home, root_relative + '/backup/' + relative)
            write_private(backup, path.read_bytes())
        write_private(path, content)
    write_private(status_path, json.dumps(status, indent=2).encode())
    print(f'Installed {len(planned) - len(staged)} credential files; staged {len(staged)} private configuration/project files for review.')
    for relative in sorted(planned):
        if not relative.startswith(root_relative):
            print('  ~/' + relative)
    if staged:
        print('Review directory: ' + str(home / root_relative / 'review'))
    print('Existing files were backed up. Imported files are mode 600.')
    print('Open a new Zsh shell to load imported environment tokens. Account tokens still need live validation.')
    return status

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Check receiver availability without importing anything.')
    args = parser.parse_args()
    if sys.platform != 'linux':
        raise ImportErrorMessage('Run the importer on Linux.')
    if args.check:
        print('Linux credential receiver is ready.')
        return
    files, manifest = read_bundle(sys.stdin.buffer.read(MAX_BUNDLE + 1))
    install_bundle(Path.home(), files, manifest)

if __name__ == '__main__':
    os.umask(0o077)
    try:
        main()
    except ImportErrorMessage as error:
        sys.exit(str(error))
    except (OSError, ValueError, UnicodeError, tarfile.TarError):
        sys.exit('Import failed: invalid bundle, credential file, or filesystem permissions. Credential values were not printed.')
