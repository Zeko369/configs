#!/bin/bash
# Apply or check the declarative macOS file associations from this checkout.
set -euo pipefail

case "${1:---check}" in
  --check|--apply) mode="${1:---check}" ;;
  --help|-h)
    echo "Usage: $0 [--check|--apply]"
    echo "Defaults to --check. Edit macos/file-associations.json to change mappings."
    exit 0
    ;;
  *) echo "Usage: $0 [--check|--apply]" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "Expected at most one argument." >&2
  exit 2
fi
if [ "$(uname -s)" != "Darwin" ]; then
  echo "File associations require macOS." >&2
  exit 1
fi
if ! /usr/bin/xcrun --find swift >/dev/null 2>&1; then
  echo "Swift is required; install Xcode Command Line Tools with xcode-select --install." >&2
  exit 1
fi

configs_dir="$(cd "$(dirname "$0")/.." && pwd)"
runner="$configs_dir/macos/file-associations.swift"
config="$configs_dir/macos/file-associations.json"
if [ "$mode" = "--apply" ]; then
  /usr/bin/xcrun swift "$runner" "$config" --apply
fi
# Check in a fresh process so Launch Services caches cannot hide a failed change.
exec /usr/bin/xcrun swift "$runner" "$config" --check
