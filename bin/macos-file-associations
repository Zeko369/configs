#!/bin/bash
# Apply or check the declarative macOS file associations from this checkout.
set -euo pipefail

usage() {
  echo "Usage: $0 [--check|--apply] [--setup]"
}

case "${1:---check}" in
  --check|--apply) mode="${1:---check}" ;;
  --help|-h)
    usage
    echo "Defaults to --check. Use --setup for the full file-association setup."
    exit 0
    ;;
  *) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != "--setup" ]; }; then
  usage >&2
  exit 2
fi
if [ "$(uname -s)" != "Darwin" ]; then
  echo "File associations require macOS." >&2
  exit 1
fi
if ! /usr/bin/xcrun --find swift >/dev/null 2>&1; then
  echo "Swift is required; install Xcode Command Line Tools with xcode-select --install." >&2
  exit 1
fi

configs_dir="$(cd "$(dirname "$0")/.." && pwd)"
runner="$configs_dir/macos/file-associations.swift"
configs=("$configs_dir/macos/file-associations.json")
if [ "${2:-}" = "--setup" ]; then
  configs+=("$configs_dir/macos/file-associations-setup.json")
fi
if [ "$mode" = "--apply" ]; then
  /usr/bin/xcrun swift "$runner" --apply "${configs[@]}"
fi
# Check in a fresh process so Launch Services caches cannot hide a failed change.
exec /usr/bin/xcrun swift "$runner" --check "${configs[@]}"
