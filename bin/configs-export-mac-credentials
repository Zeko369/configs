#!/usr/bin/env python3
"""Inventory Mac credentials or send selected credentials to Linux over SSH."""
import argparse
import datetime
import getpass
import io
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import tomllib

ENV_NAMES = {
    'OP_SERVICE_ACCOUNT_TOKEN', 'DIGITALOCEAN_ACCESS_TOKEN', 'DO_API_TOKEN',
    'VERCEL_TOKEN', 'RAILWAY_API_TOKEN', 'RAILWAY_TOKEN', 'PULUMI_ACCESS_TOKEN',
    'WAKATIME_API_KEY', 'OPENAI_API_KEY', 'ANTHROPIC_API_KEY', 'SOPS_AGE_KEY',
}
CATEGORIES = {
    'atuin', 'doctl', 'kube', 'vercel', 'railway', 'pulumi', 'graphite',
    'wakatime', 'rclone', 'cloudflared', 'sops', 'env', 'private', 'project-env',
}
MAX_FILE = 8 * 1024 * 1024
MAX_BUNDLE = 64 * 1024 * 1024

class ExportError(Exception):
    pass

def run_private(command, *, data=None, env=None):
    result = subprocess.run(command, input=data, capture_output=True, env=env)
    if result.returncode:
        raise ExportError(f'{command[0]} failed; authenticate locally and retry. Command output was kept private.')
    return result.stdout

def discover(home):
    config = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
    data = Path(os.environ.get('XDG_DATA_HOME', home / '.local/share'))
    found = {}

    def first(name, *candidates):
        for path in candidates:
            path = Path(path).expanduser()
            if path.is_file():
                found[name] = path
                break

    atuin = {}
    atuin_config = Path(os.environ.get('ATUIN_CONFIG_DIR', config / 'atuin')) / 'config.toml'
    if atuin_config.is_file():
        try:
            atuin = tomllib.loads(atuin_config.read_text())
        except (ValueError, OSError):
            pass
    first('atuin/key', atuin.get('key_path', data / 'atuin/key'))
    first('atuin/session', atuin.get('session_path', data / 'atuin/session'))
    first('doctl/config.yaml', config / 'doctl/config.yaml', home / 'Library/Application Support/doctl/config.yaml')
    first('kube/config', *[Path(p) for p in os.environ.get('KUBECONFIG', str(home / '.kube/config')).split(':') if p])
    for name in ('auth.json', 'config.json'):
        first('vercel/' + name, data / 'com.vercel.cli' / name,
              home / 'Library/Application Support/com.vercel.cli' / name,
              config / 'com.vercel.cli' / name, home / '.now' / name)
    first('railway/config.json', home / '.railway/config.json')
    pulumi = Path(os.environ.get('PULUMI_CREDENTIALS_PATH', os.environ.get('PULUMI_HOME', home / '.pulumi')))
    first('pulumi/credentials.json', pulumi / 'credentials.json')
    for name in ('user_config', 'auth', 'auth.json', 'auth_token'):
        first('graphite/' + name, config / 'graphite' / name)
    first('graphite/legacy_user_config', home / '.graphite_user_config')
    first('wakatime/config', Path(os.environ.get('WAKATIME_HOME', home)) / '.wakatime.cfg')
    first('rclone/rclone.conf', os.environ.get('RCLONE_CONFIG', config / 'rclone/rclone.conf'))
    first('sops/age-keys.txt', os.environ.get('SOPS_AGE_KEY_FILE', config / 'sops/age/keys.txt'))
    first('cloudflared/cert.pem', home / '.cloudflared/cert.pem')
    for path in sorted((home / '.cloudflared').glob('*.json')):
        if re.fullmatch(r'[0-9a-fA-F-]{36}\.json', path.name):
            first('cloudflared/' + path.name, path)
    first('private/cloudflared.yml', home / '.cloudflared/config.yml', home / '.cloudflared/config.yaml')
    repo = Path(os.environ.get('CONFIGS_DIR', home / 'repos/configs'))
    for name in ('zshrc', 'gitconfig', 'tmux.conf'):
        first('private/' + name, repo / 'local' / name)
    first('private/mise.toml', config / 'mise/config.toml')
    return found

def create_op_token(vaults, name):
    if not shutil.which('op'):
        raise ExportError('Install 1Password CLI on the Mac before creating a service account.')
    env = {k: v for k, v in os.environ.items() if k not in ('OP_SERVICE_ACCOUNT_TOKEN', 'OP_CONNECT_TOKEN', 'OP_CONNECT_HOST')}
    command = ['op', 'service-account', 'create', name, '--raw', '--expires-in', '90d']
    for vault in vaults:
        if ':' in vault or not vault.strip():
            raise ExportError('--op-vault must be a vault name or ID without permissions appended.')
        command.extend(['--vault', vault + ':read_items'])
    token = run_private(command, env=env).decode().strip()
    if not token.startswith('ops_'):
        raise ExportError('1Password returned an unexpected service account token format.')
    item = {'title': name, 'category': 'API_CREDENTIAL', 'fields': [
        {'id': 'credential', 'type': 'CONCEALED', 'label': 'credential', 'value': token},
    ]}
    result = subprocess.run(['op', 'item', 'create', '--vault', vaults[0], '--format', 'json'],
                            input=json.dumps(item).encode(), capture_output=True, env=env)
    if result.returncode:
        fd, recovery = tempfile.mkstemp(prefix='.op-service-account-recovery-', dir=Path.home())
        with os.fdopen(fd, 'w') as stream:
            stream.write(token + '\n')
        print(f'1Password could not save the new token as an item. A mode-600 recovery copy is at {recovery}; save it in 1Password afterward.', file=sys.stderr)
    else:
        print('Created a 90-day read-only service account and saved its token in 1Password.')
    return token

def collect(found, selected):
    payload = {}
    notes = []
    for name, path in sorted(found.items()):
        if name.split('/')[0] not in selected:
            continue
        if name == 'kube/config':
            if not shutil.which('kubectl'):
                notes.append('Kubernetes skipped: kubectl is needed to embed referenced certificate/key files.')
                continue
            content = run_private(['kubectl', 'config', 'view', '--raw', '--flatten'])
        else:
            if path.stat().st_size > MAX_FILE:
                raise ExportError(f'{name} exceeds the file size limit.')
            content = path.read_bytes()
        if not content.strip():
            continue
        if name == 'vercel/auth.json':
            obj = json.loads(content)
            if not any(obj.get(key) for key in ('token', 'accessToken', 'refreshToken')):
                notes.append('Vercel auth skipped: credentials may be in macOS Keychain; run vercel login on Linux.')
                continue
        if name == 'pulumi/credentials.json':
            obj = json.loads(content)
            if not any(obj.get(key) for key in ('accounts', 'accessTokens')):
                notes.append('Pulumi auth skipped: credentials may be encrypted or absent; run pulumi login on Linux.')
                continue
        if name == 'doctl/config.yaml':
            content = re.sub(r'^config:.*(?:\n|$)', '', content.decode(), flags=re.MULTILINE).encode()
        payload[name] = content
    return payload, notes

def archive(payload, notes):
    manifest = {'format': 1, 'created_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                'files': sorted(payload), 'notes': notes}
    entries = {'manifest.json': json.dumps(manifest).encode(), **payload}
    output = io.BytesIO()
    with tarfile.open(fileobj=output, mode='w') as tar:
        for name, content in entries.items():
            if len(content) > MAX_FILE:
                raise ExportError(f'{name} exceeds the file size limit.')
            member = tarfile.TarInfo(name)
            member.size = len(content)
            member.mode = 0o600
            tar.addfile(member, io.BytesIO(content))
    if output.tell() > MAX_BUNDLE:
        raise ExportError('Selected credentials exceed the bundle size limit.')
    return output.getvalue()

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='ubuntu@100.90.160.94')
    parser.add_argument('--send', action='store_true', help='Transfer available selected files; without this flag only inventory them.')
    parser.add_argument('--only', help='Comma-separated categories: ' + ','.join(sorted(CATEGORIES)))
    parser.add_argument('--project-env', action='append', default=[], metavar='FILE', help='Stage a specific project .env file for later review; never load it automatically.')
    op = parser.add_mutually_exclusive_group()
    op.add_argument('--op-token', action='store_true', help='Read an existing service account token through a hidden local prompt.')
    op.add_argument('--op-token-ref', metavar='op://VAULT/ITEM/FIELD', help='Read an existing service account token from 1Password.')
    op.add_argument('--create-op-service-account', action='store_true', help='Create a 90-day read-only service account for the specified vaults.')
    parser.add_argument('--op-vault', action='append', default=[], metavar='VAULT', help='Vault allowed for the new service account; repeat to add another vault.')
    parser.add_argument('--op-name', default='dev-linux-configs')
    args = parser.parse_args()
    if sys.platform != 'darwin':
        raise ExportError('Run this exporter on macOS. The importer runs on Linux.')
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.@:-]*', args.host):
        parser.error('Use an SSH host alias or user@hostname without options or shell syntax.')
    selected = set(args.only.split(',')) if args.only else CATEGORIES
    if not selected <= CATEGORIES:
        parser.error('Unknown category in --only.')
    if args.create_op_service_account and not args.op_vault:
        parser.error('--create-op-service-account needs at least one --op-vault. Personal/Private vaults are unsupported.')
    if (args.op_token or args.op_token_ref or args.create_op_service_account) and not args.send:
        parser.error('1Password token operations require --send.')
    if args.op_vault and not args.create_op_service_account:
        parser.error('--op-vault requires --create-op-service-account.')
    if (args.op_token or args.op_token_ref or args.create_op_service_account) and 'env' not in selected:
        parser.error('Include env in --only when transferring a 1Password service account token.')
    found = discover(Path.home())
    for index, source in enumerate(args.project_env):
        path = Path(source).expanduser().resolve(strict=True)
        name = re.sub(r'[^A-Za-z0-9_.-]', '_', path.name)
        found[f'project-env/{index:03d}-{name}'] = path
    print('Available files (names only):')
    for name in sorted(found):
        if name.split('/')[0] in selected:
            print('  ' + name)
    env = {key: os.environ[key] for key in sorted(ENV_NAMES) if os.environ.get(key)} if 'env' in selected else {}
    if env:
        print('Available environment variables: ' + ', '.join(sorted(env)))
    print('GitHub, Codex and SSH private keys are already configured on Linux and are excluded.')
    if not args.send:
        print('Inventory only. Add --send to transfer these categories; use --only to narrow them.')
        return
    subprocess.run(['ssh', '--', args.host, 'python3 "$HOME/repos/configs/bin/configs-import-credentials" --check'], check=True)
    payload, notes = collect(found, selected)
    if args.op_token:
        env['OP_SERVICE_ACCOUNT_TOKEN'] = getpass.getpass('1Password service account token (hidden): ').strip()
    elif args.op_token_ref:
        env['OP_SERVICE_ACCOUNT_TOKEN'] = run_private(['op', 'read', args.op_token_ref]).decode().strip()
    elif args.create_op_service_account:
        env['OP_SERVICE_ACCOUNT_TOKEN'] = create_op_token(args.op_vault, args.op_name)
    if 'OP_SERVICE_ACCOUNT_TOKEN' in env and not env['OP_SERVICE_ACCOUNT_TOKEN'].startswith('ops_'):
        raise ExportError('Expected a 1Password service account token beginning with ops_.')
    if env:
        payload['env.json'] = json.dumps(env).encode()
    if not payload:
        raise ExportError('No selected portable credentials were found. Use provider login commands on Linux.')
    for note in notes:
        print(note)
    subprocess.run(['ssh', '--', args.host, 'python3 "$HOME/repos/configs/bin/configs-import-credentials"'],
                   input=archive(payload, notes), check=True)
    print('Transfer complete. Return only the status output to the setup session; credential values were never printed.')

if __name__ == '__main__':
    os.umask(0o077)
    try:
        main()
    except ExportError as error:
        sys.exit(str(error))
    except (OSError, ValueError, subprocess.SubprocessError):
        sys.exit('Export failed. Check local login/file availability and the SSH connection; private command output was not printed.')
